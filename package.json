{
  "name": "novachess-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/check-build-config.mjs && tsc -b && vite build && node scripts/offline.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run test:unit && playwright test",
    "postinstall": "node scripts/prepare-assets.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "prepare:federations": "node scripts/prepare-federation-function.mjs",
    "check:online": "node scripts/check-online-backend.mjs",
    "test:online": "playwright test --config playwright.online.config.ts"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/nunito-sans": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "chess.js": "^1.4.0",
    "ffish-es6": "^0.7.10",
    "gifenc": "^1.0.3",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "stockfish": "^19.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
