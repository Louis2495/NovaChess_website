# Public browser credentials: use the project's anon/publishable key, NEVER the service_role key.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Optional: federation lookup works independently of online accounts.
# Deploy federation-records with JWT verification OFF, then supply its public URL.
VITE_FEDERATION_LOOKUP_URL=https://YOUR_PROJECT.supabase.co/functions/v1/federation-records
